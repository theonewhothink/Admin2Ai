# Copy to .env for local development (docker compose reads it automatically).
# No real secrets here: replace every change-me value with your own local one.
# In AWS these come from Secrets Manager and the task definitions (infra/terraform).

# --- PostgreSQL (docker-compose: postgres, migrate) ------------------------------
# Superuser of the local container; migrations run as it (schema owner).
POSTGRES_PASSWORD=change-me-postgres
# Password of backoffice_api, the api/worker login (member of backoffice_app, RLS applies).
BACKOFFICE_DB_APP_PASSWORD=change-me-app
# Image override; must ship pgvector (0005_evidence_embeddings).
POSTGRES_IMAGE=pgvector/pgvector:pg16

# Application connection (set by docker-compose from the values above; set it
# yourself when running the api outside compose).
# DATABASE_URL=postgresql://backoffice_api:change-me-app@localhost:5432/backoffice
# Migration runner (python -m backoffice_db migrate); falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/backoffice

# --- Redis ----------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_IMAGE=redis:7.4-alpine
# REDIS_URL=redis://:change-me-redis@localhost:6379/0

# --- Evidence object storage (S3-compatible, EU, versioned, Object Lock) ---------
AWS_REGION=eu-south-2
EVIDENCE_BUCKET=backoffice-evidence-eu
# Default Object Lock retention (GOVERNANCE) of the LOCAL bucket, in days. Keep it
# short locally; the production retention is a Terraform variable.
EVIDENCE_RETENTION_DAYS=1
# Local MinIO root credentials (also used by the api/worker locally).
MINIO_ROOT_USER=backoffice-local
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
AWS_CLI_IMAGE=amazon/aws-cli:2.37.4
# Set by docker-compose for the containers:
# S3_ENDPOINT_URL=http://localhost:9000
# EVIDENCE_OBJECT_LOCK_MODE=GOVERNANCE

# --- Temporal (backoffice.workflows.worker) -------------------------------------
TEMPORAL_VERSION=1.29.7
TEMPORAL_UI_VERSION=2.54.1
TEMPORAL_NAMESPACE=backoffice
TEMPORAL_TASK_QUEUE=backoffice
# TEMPORAL_ADDRESS=localhost:7233
# package.module:factory returning WorkflowServices. The worker refuses to start
# without it (no stand-in services).
BACKOFFICE_WORKFLOW_SERVICES=
# Temporal Cloud / mTLS (leave unset locally):
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=true
# TEMPORAL_TLS_CLIENT_CERT_PATH=
# TEMPORAL_TLS_CLIENT_KEY_PATH=
# TEMPORAL_TLS_SERVER_CA_CERT_PATH=
# TEMPORAL_TLS_SERVER_NAME=

# --- Audit log ------------------------------------------------------------------
# HMAC-SHA-256 key of the hash-chained audit log, at least 32 characters.
AUDIT_HMAC_KEY=change-me-local-audit-key-at-least-32-chars

# --- Logging --------------------------------------------------------------------
# The api logs one JSON line per request (no personal data) at INFO.
LOG_LEVEL=INFO

# --- Production API (backend/src/backoffice/server) -------------------------------
# demo (default outside compose): the single built-in demo business, no sign-in
# (tests, the static site). production: real businesses, sign-in, data saved in
# PostgreSQL (DATABASE_URL, the backoffice_api login). docker compose runs production.
BACKOFFICE_MODE=production
# Uvicorn worker processes (tenants are shared through the database) and the
# proxy addresses allowed to set the client address (sign-in rate limits per IP).
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=127.0.0.1
# Exact origins of the web app allowed to call the API with its cookie (comma-separated).
BACKOFFICE_ALLOWED_ORIGINS=http://localhost:3000
# Public base URLs: OAuth and bank redirects come back to the API, then go to the web app.
BACKOFFICE_API_URL=http://localhost:8000
BACKOFFICE_WEB_URL=http://localhost:3000
# 1 = session cookie without the Secure flag, for plain http://localhost only. Never in production.
BACKOFFICE_INSECURE_COOKIES=1
# Emails that get the admin role (internal dashboard) when their account is created.
BACKOFFICE_ADMIN_EMAILS=
# At least 32 characters: signs OAuth state and bank-link references, keys the
# hashes the sign-in rate limiter stores. Keep it stable across restarts.
BACKOFFICE_STATE_KEY=change-me-local-state-key-at-least-32-chars
# Seals stored sign-ins (mailbox refresh tokens, IMAP app passwords, bank consents):
# base64 of 32 random bytes, e.g.
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Empty = no stored sign-ins (mailbox and bank connections stay off).
BACKOFFICE_VAULT_KEY=
# In AWS use KMS instead of a local key (the task role needs kms:GenerateDataKey/Decrypt):
# BACKOFFICE_VAULT_KMS_KEY_ID=
# Evidence files: S3 when S3_BUCKET is set (AWS_REGION, S3_ENDPOINT_URL,
# EVIDENCE_KMS_KEY_ID apply), else this directory (a volume in compose).
# S3_BUCKET=
# S3_PREFIX=
# 1 = account erasure may bypass GOVERNANCE Object Lock (needs s3:BypassGovernanceRetention).
# S3_BYPASS_GOVERNANCE_ON_ERASURE=
# In AWS only the evidence-deletion role may delete originals (§25): with this set, the
# api leaves an erased account's files to the sync worker, which assumes the role
# (STS) and removes every version, also in the disaster-recovery copy (deletions are
# not replicated). Unset locally: the files are removed at once.
# S3_ERASURE_ROLE_ARN=
# S3_REPLICA_BUCKET=
# S3_REPLICA_REGION=
BACKOFFICE_OBJECT_DIR=/var/lib/backoffice/objects
# Tuning (defaults shown):
# BACKOFFICE_DB_POOL_SIZE=10
# BACKOFFICE_TENANT_CACHE_SIZE=200
# BACKOFFICE_MAX_JSON_BYTES=1048576
# 1 = a read that changes a business raises instead of being logged and rebuilt (tests only).
# BACKOFFICE_STRICT_READS=

# The sync worker (python -m backoffice.server.worker; compose service sync-worker)
# reads connected mailboxes and banks into every business and runs each business's
# day. Seconds between syncs of one mailbox (banks: at most every 6 hours), and how
# far back a first sync reads (§6: 90 days, up to 365). Its database login must also
# be a member of backoffice_scheduler (ensure-login --member-of backoffice_scheduler).
BACKOFFICE_SYNC_INTERVAL=900
BACKOFFICE_HISTORY_DAYS=90

# Reading PDFs and photos (backoffice.reading): PDF text and QR codes locally, OCR
# through a PP-OCRv6 sidecar when BACKOFFICE_OCR_URL is set, and the Claude vision
# fallback only with BACKOFFICE_EXTERNAL_AI=on (then a file may leave, §53).
# Every reading is recorded in the business's log, so a replay never reads again.
BACKOFFICE_DOCUMENT_READING=on
# Invoice links in emails and links shared from the phone (§9): opened by the server
# before each change is recorded (http(s) only, never private or metadata addresses,
# every redirect checked again), and kept in the business's log, so a replay never
# opens a link again. off: links wait unopened.
BACKOFFICE_LINK_FETCHING=on
BACKOFFICE_OCR_URL=
BACKOFFICE_EXTERNAL_AI=off
# BACKOFFICE_OCR_PATH=/ocr
# BACKOFFICE_OCR_API_KEY=
# BACKOFFICE_OCR_TIMEOUT=
# BACKOFFICE_OCR_VL_URL=
# BACKOFFICE_OCR_VL_PATH=/layout-parsing
# BACKOFFICE_OCR_VL_API_KEY=
# BACKOFFICE_VISION_MODEL=
# BACKOFFICE_VISION_URL=https://api.anthropic.com
# BACKOFFICE_VISION_COST_PER_PAGE=0.02
# BACKOFFICE_VISION_MAX_PAGES=10
# BACKOFFICE_OCR_MONTHLY_BUDGET=5.00

# Mailbox sign-in: OAuth apps registered with Google Cloud and Microsoft Entra,
# redirect URI <BACKOFFICE_API_URL>/api/oauth/callback. Empty = off.
BACKOFFICE_GOOGLE_CLIENT_ID=
BACKOFFICE_GOOGLE_CLIENT_SECRET=
BACKOFFICE_MICROSOFT_CLIENT_ID=
BACKOFFICE_MICROSOFT_CLIENT_SECRET=
# Bank connections (PSD2) through GoCardless Bank Account Data. Empty = off.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# GOCARDLESS_API_URL=https://bankaccountdata.gocardless.com/api/v2
# Outgoing email the owner tapped Send on (SMTP, e.g. Amazon SES in the EU). Empty host = off.
BACKOFFICE_SMTP_HOST=
BACKOFFICE_SMTP_PORT=587
BACKOFFICE_SMTP_USER=
BACKOFFICE_SMTP_PASSWORD=
BACKOFFICE_SMTP_FROM=
# Push notifications through Expo (optional access token for "enhanced security").
EXPO_ACCESS_TOKEN=
# 1 = never send push notifications.
# BACKOFFICE_PUSH_DISABLED=
# The server-side chat model (Claude). Empty = the built-in rules answer.
ANTHROPIC_API_KEY=

# --- Set by the infrastructure in AWS (infra/terraform/ecs.tf) -----------------
# Listed so every variable a container receives is documented; not needed locally.
# EVIDENCE_KMS_KEY_ID=         KMS key ARN for SSE-KMS on the evidence bucket
# EVENT_BUS_NAME=              EventBridge bus for domain events
# INGEST_QUEUE_URL=            SQS queue: new evidence
# OCR_QUEUE_URL=               SQS queue: OCR jobs
# NOTIFICATIONS_QUEUE_URL=     SQS queue: owner notifications
# OCR_SERVICE_URL=             self-hosted OCR service (Cloud Map DNS)
# EVIDENCE_DELETION_ROLE_ARN=  role the worker assumes for approved deletions only
# FORWARDED_ALLOW_IPS=         uvicorn: trust proxy headers from the load balancer
# APP_DB_PASSWORD=             migrate task: password for ensure-login backoffice_api
# PGPASSWORD=                  migrate task: schema owner password (RDS-managed secret)

# --- Tests (backend/tests/test_infra_postgres.py) -------------------------------
# Superuser URL of a disposable server; unset = start a throwaway local cluster.
# BACKOFFICE_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Directory with initdb/pg_ctl/postgres/psql when not on the default paths.
# BACKOFFICE_PG_BINDIR=/usr/lib/postgresql/16/bin
