# Copy to .env for local development (docker compose reads it automatically).
# No real secrets here: replace every change-me value with your own local one.
# In AWS these come from Secrets Manager and the task definitions (infra/terraform).

# --- PostgreSQL (docker-compose: postgres, migrate) ------------------------------
# Superuser of the local container; migrations run as it (schema owner).
POSTGRES_PASSWORD=change-me-postgres
# Password of backoffice_api, the api/worker login (member of backoffice_app, RLS applies).
BACKOFFICE_DB_APP_PASSWORD=change-me-app
# Image override; must ship pgvector (0005_evidence_embeddings).
POSTGRES_IMAGE=pgvector/pgvector:pg16

# Application connection (set by docker-compose from the values above; set it
# yourself when running the api outside compose).
# DATABASE_URL=postgresql://backoffice_api:change-me-app@localhost:5432/backoffice
# Migration runner (python -m backoffice_db migrate); falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/backoffice

# --- Redis ----------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_IMAGE=redis:7.4-alpine
# REDIS_URL=redis://:change-me-redis@localhost:6379/0

# --- Evidence object storage (S3-compatible, EU, versioned, Object Lock) ---------
AWS_REGION=eu-south-2
EVIDENCE_BUCKET=backoffice-evidence-eu
# Default Object Lock retention (GOVERNANCE) of the LOCAL bucket, in days. Keep it
# short locally; the production retention is a Terraform variable.
EVIDENCE_RETENTION_DAYS=1
# Local MinIO root credentials (also used by the api/worker locally).
MINIO_ROOT_USER=backoffice-local
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
AWS_CLI_IMAGE=amazon/aws-cli:2.37.4
# Set by docker-compose for the containers:
# S3_ENDPOINT_URL=http://localhost:9000
# EVIDENCE_OBJECT_LOCK_MODE=GOVERNANCE

# --- Temporal (backoffice.workflows.worker) -------------------------------------
TEMPORAL_VERSION=1.29.7
TEMPORAL_UI_VERSION=2.54.1
TEMPORAL_NAMESPACE=backoffice
TEMPORAL_TASK_QUEUE=backoffice
# TEMPORAL_ADDRESS=localhost:7233
# package.module:factory returning WorkflowServices. The worker refuses to start
# without it (no stand-in services).
BACKOFFICE_WORKFLOW_SERVICES=
# Temporal Cloud / mTLS (leave unset locally):
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=true
# TEMPORAL_TLS_CLIENT_CERT_PATH=
# TEMPORAL_TLS_CLIENT_KEY_PATH=
# TEMPORAL_TLS_SERVER_CA_CERT_PATH=
# TEMPORAL_TLS_SERVER_NAME=

# --- Audit log ------------------------------------------------------------------
# HMAC-SHA-256 key of the hash-chained audit log, at least 32 characters.
AUDIT_HMAC_KEY=change-me-local-audit-key-at-least-32-chars

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Set by the infrastructure in AWS (infra/terraform/ecs.tf) -----------------
# Listed so every variable a container receives is documented; not needed locally.
# EVIDENCE_KMS_KEY_ID=         KMS key ARN for SSE-KMS on the evidence bucket
# EVENT_BUS_NAME=              EventBridge bus for domain events
# INGEST_QUEUE_URL=            SQS queue: new evidence
# OCR_QUEUE_URL=               SQS queue: OCR jobs
# NOTIFICATIONS_QUEUE_URL=     SQS queue: owner notifications
# OCR_SERVICE_URL=             self-hosted OCR service (Cloud Map DNS)
# EVIDENCE_DELETION_ROLE_ARN=  role the worker assumes for approved deletions only
# FORWARDED_ALLOW_IPS=         uvicorn: trust proxy headers from the load balancer
# APP_DB_PASSWORD=             migrate task: password for ensure-login backoffice_api
# PGPASSWORD=                  migrate task: schema owner password (RDS-managed secret)

# --- Tests (backend/tests/test_infra_postgres.py) -------------------------------
# Superuser URL of a disposable server; unset = start a throwaway local cluster.
# BACKOFFICE_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Directory with initdb/pg_ctl/postgres/psql when not on the default paths.
# BACKOFFICE_PG_BINDIR=/usr/lib/postgresql/16/bin
